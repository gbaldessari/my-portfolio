# Production site URL (no trailing slash). Required for correct canonical URLs, Open Graph links, and sitemap.
# Copied to .env / .env.local — used by Vite and by `npm run build` (scripts/generate-sitemap.mjs).
VITE_SITE_URL=https://your-domain.com

# WhatsApp number with country code, digits only (e.g. 56912345678)
VITE_WHATSAPP_NUMBER=56912345678
